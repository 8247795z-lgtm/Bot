def load_custom():
    if os.path.exists(CUSTOM_FILE):
        try:
            with open(CUSTOM_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except:
            return {"truth": [], "dare": []}
    return {"truth": [], "dare": []}

def save_custom(data):
    with open(CUSTOM_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

custom_tasks = load_custom()

def for_kb():
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Ей 👩", callback_data="for_her"),
            InlineKeyboardButton("Ему 👨", callback_data="for_him"),
            InlineKeyboardButton("Обоим 💑", callback_data="for_both")
        ]
    ])

def level_kb():
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Лёгкий 💚", callback_data="level_light"),
            InlineKeyboardButton("Средний 💛", callback_data="level_medium"),
            InlineKeyboardButton("Жёсткий ❤️", callback_data="level_hard")
        ]
    ])

def type_kb():
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Правда 💙", callback_data="type_truth"),
            InlineKeyboardButton("Действие 🔥", callback_data="type_dare")
        ],
        [InlineKeyboardButton("« Назад в меню", callback_data="back_main")]
    ])

def main_menu_kb():
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("Играть 🔥", callback_data="play")],
        [InlineKeyboardButton("Добавить своё задание ➕", callback_data="add_task")],
        [InlineKeyboardButton("Показать мои задания 📋", callback_data="show_custom")]
    ])

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (
        "🔥 <b>Правда или Действие 18+</b>\n\n"
        "Задания с сайта + твои собственные.\n\n"
        "Выбери действие:"
    )
    await update.message.reply_text(text, reply_markup=main_menu_kb(), parse_mode="HTML")

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    user_data = context.user_data

    if data == "play":
        await query.edit_message_text("Кому задание?", reply_markup=for_kb())
        return

    if data.startswith("for_"):
        user_data["for"] = data.replace("for_", "")
        await query.edit_message_text("Выбери сложность:", reply_markup=level_kb())
        return

    if data.startswith("level_"):
        user_data["level"] = data.replace("level_", "")
        await query.edit_message_text("Правда или Действие?", reply_markup=type_kb())
        return

    if data.startswith("type_"):
        ttype = data.replace("type_", "")
        level = user_data.get("level", "medium")
        for_who = user_data.get("for", "both")

        pool = []
        try:
            pool.extend(tasks[level][for_who].get(ttype, []))
        except KeyError:
            pass
        try:
            pool.extend(tasks[level]["both"].get(ttype, []))
        except KeyError:
            pass
        pool.extend(custom_tasks.get(ttype, []))

        if not pool:
            await query.edit_message_text("В этой категории пока нет заданий 😔", reply_markup=type_kb())
            return

        task = random.choice(pool)
        emoji = "💙" if ttype == "truth" else "🔥"
        title = "ПРАВДА" if ttype == "truth" else "ДЕЙСТВИЕ"
        who = {"her": "Ей", "him": "Ему", "both": "Обоим"}.get(for_who, "Обоим")
        level_name = {"light": "Лёгкий", "medium": "Средний", "hard": "Жёсткий"}.get(level, "Средний")

        text = f"{emoji} <b>{title}</b> ({who} • {level_name})\n\n{task}"
        await query.edit_message_text(text, reply_markup=type_kb(), parse_mode="HTML")
        return

    if data == "back_main":
        await query.edit_message_text("Главное меню:", reply_markup=main_menu_kb())
        return

    if data == "add_task":
        await query.edit_message_text(
            "Что добавляем?",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton("Правда", callback_data="add_truth"),
                    InlineKeyboardButton("Действие", callback_data="add_dare")
                ],
                [InlineKeyboardButton("« Отмена", callback_data="back_main")]
            ])
        )
        return

    if data in ["add_truth", "add_dare"]:
        user_data["add_type"] = data.replace("add_", "")
        await query.edit_message_text("Напиши текст задания и отправь обычным сообщением:")
        return

    if data == "show_custom":
        truths = custom_tasks.get("truth", [])
        dares = custom_tasks.get("dare", [])
        text = "<b>Твои задания:</b>\n\n"
        text += "<b>Правда:</b>\n" + ("\n".join(f"• {t}" for t in truths) if truths else "— пусто") + "\n\n"
        text += "<b>Действие:</b>\n" + ("\n".join(f"• {d}" for d in dares) if dares else "— пусто")
        await query.edit_message_text(text, reply_markup=main_menu_kb(), parse_mode="HTML")
        return

async def add_task_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    if not text:
        await update.message.reply_text("Пустое сообщение.")
        return

    add_type = context.user_data.get("add_type")
    if not add_type:
        await update.message.reply_text("Сначала выбери тип задания через меню (/start).")
        return

    custom_tasks.setdefault(add_type, []).append(text)
    save_custom(custom_tasks)

    await update.message.reply_text(
        f"✅ Задание добавлено!\n\n{text}",
        reply_markup=main_menu_kb()
    )
    context.user_data.pop("add_type", None)

def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, add_task_text))
    print("Бот запущен...")
    app.run_polling()

if __name__ == "__main__":
    main()
