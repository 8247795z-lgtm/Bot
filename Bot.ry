hard_her = [
    "Сними видео, как медленно снимаешь трусики.",
    "Сделай фото вагины крупным планом.",
    "Сними, как гладишь себя между ног.",
    "Пришли фото с пальцами внутри.",
    "Сделай видео, как сжимаешь грудь.",
    "Пришли фото в позе догги-стайл."
]

hard_him = [
    "Сними видео возбуждённого члена.",
    "Сделай фото члена в руке.",
    "Сними, как дрочишь.",
    "Пришли фото с каплей смазки.",
    "Сделай видео, как кончаешь.",
    "Пришли фото члена крупным планом."
]

games = {}

def solo_kb():
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Правда 💙", callback_data="solo_truth"),
            InlineKeyboardButton("Действие 🔥", callback_data="solo_dare")
        ],
        [InlineKeyboardButton("⭐ Избранное", callback_data="show_fav")]
    ])

def join_kb():
    return InlineKeyboardMarkup([[InlineKeyboardButton("✅ Я играю", callback_data="join")]])

def role_kb(uid):
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Я — Он 👨", callback_data=f"role_him_{uid}"),
            InlineKeyboardButton("Я — Она 👩", callback_data=f"role_her_{uid}")
        ]
    ])

def mood_kb():
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Романтичный 💕", callback_data="mood_romantic"),
            InlineKeyboardButton("Пошлый 🔥", callback_data="mood_dirty")
        ],
        [InlineKeyboardButton("Жёсткий 😈", callback_data="mood_hard")]
    ])

def turn_kb(uid):
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Правда 💙", callback_data=f"truth_{uid}"),
            InlineKeyboardButton("Действие 🔥", callback_data=f"dare_{uid}")
        ],
        [
            InlineKeyboardButton("🔄 Пас", callback_data=f"pass_{uid}"),
            InlineKeyboardButton("📊 Статистика", callback_data="stats")
        ],
        [InlineKeyboardButton("🏁 Завершить игру", callback_data="end")]
    ])

def after_kb(uid):
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("⭐ Хочу это в реале", callback_data=f"fav_{uid}")],
        [InlineKeyboardButton("✅ Я выполнил(а)", callback_data=f"done_{uid}")]
    ])

def get_task(mood, ttype, role=None):
    pool = tasks.get(mood, {}).get(ttype, []).copy()
    if mood == "hard" and ttype == "dare":
        if role == "her":
            pool.extend(hard_her)
        elif role == "him":
            pool.extend(hard_him)
    return random.choice(pool) if pool else "Заданий нет"

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🔥 <b>Правда или Действие 18+</b>\n\n"
        "В личке — просто играй\nВ группе — /game",
        reply_markup=solo_kb(),
        parse_mode="HTML"
    )

async def game_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_chat.type == "private":
        await update.message.reply_text("Используй /game в группе.")
        return

    chat_id = update.effective_chat.id
    games[chat_id] = {
        "players": [], "names": {}, "roles": {}, "scores": {},
        "passes": {}, "current": None, "mood": "dirty", "last_task": None
    }
    await update.message.reply_text("🔥 Игра на двоих\nОба нажмите:", reply_markup=join_kb())

async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    user = query.from_user
    uid = user.id
    name = user.first_name
    chat_id = query.message.chat_id
    game = games.get(chat_id)

    # ===== Одиночная =====
    if data == "solo_truth":
        task = random.choice(tasks["dirty"]["truth"] + tasks["hard"]["truth"])
        context.user_data["last_task"] = task
        await query.message.reply_text(
            f"💙 <b>ПРАВДА</b>\n\n{task}",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("⭐ Хочу это в реале", callback_data="solo_fav")],
                [InlineKeyboardButton("Ещё Правда", callback_data="solo_truth"),
                 InlineKeyboardButton("Действие", callback_data="solo_dare")]
            ]),
            parse_mode="HTML"
        )
        return

    if data == "solo_dare":
        task = random.choice(tasks["dirty"]["dare"] + tasks["hard"]["dare"])
        context.user_data["last_task"] = task
        await query.message.reply_text(
            f"🔥 <b>ДЕЙСТВИЕ</b>\n\n{task}",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("⭐ Хочу это в реале", callback_data="solo_fav")],
                [InlineKeyboardButton("Правда", callback_data="solo_truth"),
                 InlineKeyboardButton("Ещё Действие", callback_data="solo_dare")]
            ]),
            parse_mode="HTML"
        )
        return

    if data == "solo_fav":
        task = context.user_data.get("last_task")
        if task:
            favorites.setdefault(str(uid), []).append(task)
            save_fav(favorites)
            await query.answer("Добавлено в «Хочу в реале» ⭐")
        return

    if data == "show_fav":
        favs = favorites.get(str(uid), [])
        text = "<b>⭐ Хочу это в реале:</b>\n\n" + ("\n".join(f"• {f}" for f in favs) if favs else "Пока пусто")
        await query.message.reply_text(text, parse_mode="HTML", reply_markup=solo_kb())
        return

    # ===== Группа =====
    if data == "join":
        if not game:
            await query.answer("Сначала /game", show_alert=True)
            return
        if uid in game["players"]:
            await query.answer("Уже в игре", show_alert=True)
            return
        game["players"].append(uid)
        game["names"][uid] = name
        game["scores"][uid] = 0
        game["passes"][uid] = 1
        if len(game["players"]) == 1:
            await query.edit_message_text(f"{name} в игре. Ждём второго...", reply_markup=join_kb())
        else:
            await query.edit_message_text(f"Оба в игре!\n{game['names'][game['players'][0]]}, выбери роль:", reply_markup=role_kb(game["players"][0]))
        return

    if data.startswith("role_"):
        role, target = data.split("_")[1], int(data.split("_")[2])
        if uid != target:
            await query.answer("Не твоя кнопка", show_alert=True)
            return
        game["roles"][uid] = role
        other = [p for p in game["players"] if p != uid][0]
        if other not in game["roles"]:
            await query.edit_message_text(f"{name} выбрал(а).\nТеперь {game['names'][other]}:", reply_markup=role_kb(other))
        else:
            await query.edit_message_text("Выберите настроение:", reply_markup=mood_kb())
        return

    if data.startswith("mood_"):
        game["mood"] = data.replace("mood_", "")
        game["current"] = random.choice(game["players"])
        mood_name = {"romantic": "Романтичный", "dirty": "Пошлый", "hard": "Жёсткий"}[game["mood"]]
        await query.edit_message_text(
            f"Игра началась!\nНастроение: <b>{mood_name}</b>\n\nСейчас ходит: <b>{game['names'][game['current']]}</b>",
            reply_markup=turn_kb(game["current"]), parse_mode="HTML")
        return

    # ===== Главное изменение: задание приходит НОВЫМ сообщением =====
    if data.startswith("truth_") or data.startswith("dare_"):
        action, target = data.split("_")
        target = int(target)
        if not game or uid != target or uid != game.get("current"):
            await query.answer("Не твой ход!", show_alert=True)
            return

        role = game["roles"].get(uid)
        task = get_task(game["mood"], action, role)
        game["last_task"] = task
        title = "ПРАВДА" if action == "truth" else "ДЕЙСТВИЕ"
        emoji = "💙" if action == "truth" else "🔥"

        # Отправляем НОВОЕ сообщение (задание останется в чате)
        await query.message.reply_text(
            f"{emoji} <b>{title}</b> для {name}\n\n{task}",
            reply_markup=after_kb(uid),
            parse_mode="HTML"
        )
        return

    if data.startswith("fav_"):
        task = game.get("last_task") if game else None
        if task:
            favorites.setdefault(str(chat_id), []).append(task)
            save_fav(favorites)
            await query.answer("Добавлено в «Хочу в реале» ⭐")
        return

    if data.startswith("done_"):
        target = int(data.split("_")[1])
        if not game or uid != target:
            await query.answer("Не твоя кнопка", show_alert=True)
            return

        game["scores"][uid] += 1
        other = game["players"][0] if game["current"] == game["players"][1] else game["players"][1]
        game["current"] = other

        # Новое сообщение с передачей хода
        await query.message.reply_text(
            f"✅ <b>{name}</b> выполнил(а) задание!\n\n"
            f"📊 Счёт:\n"
            f"{game['names'][uid]} — <b>{game['scores'][uid]}</b>\n"
            f"{game['names'][other]} — <b>{game['scores'][other]}</b>\n\n"
            f"Сейчас ходит: <b>{game['names'][other]}</b>",
            reply_markup=turn_kb(other),
            parse_mode="HTML"
        )
        return

    if data.startswith("pass_"):
        target = int(data.split("_")[1])
        if not game or uid != target or game["passes"].get(uid, 0) <= 0:
            await query.answer("Пасов больше нет или не твой ход", show_alert=True)
            return

        game["passes"][uid] -= 1
        other = game["players"][0] if game["current"] == game["players"][1] else game["players"][1]
        game["current"] = other

        await query.message.reply_text(
            f"🔄 <b>{name}</b> использовал(а) пас.\n\nСейчас ходит: <b>{game['names'][other]}</b>",
            reply_markup=turn_kb(other),
            parse_mode="HTML"
        )
        return

    if data == "stats":
        if not game:
            await query.answer("Игра не найдена")
            return
        p1, p2 = game["players"]
        text = (
            f"📊 <b>Текущая статистика</b>\n\n"
            f"{game['names'][p1]}: <b>{game['scores'][p1]}</b> заданий\n"
            f"{game['names'][p2]}: <b>{game['scores'][p2]}</b> заданий\n\n"
            f"Пасы остались:\n"
            f"{game['names'][p1]} — {game['passes'][p1]}\n"
            f"{game['names'][p2]} — {game['passes'][p2]}"
        )
        await query.message.reply_text(text, parse_mode="HTML")
        return

    if data == "end":
        if chat_id in games:
            p1, p2 = games[chat_id]["players"]
            s1 = games[chat_id]["scores"][p1]
            s2 = games[chat_id]["scores"][p2]
            winner = ""
            if s1 > s2:
                winner = f"\n\n🏆 Победитель: <b>{games[chat_id]['names'][p1]}</b>"
            elif s2 > s1:
                winner = f"\n\n🏆 Победитель: <b>{games[chat_id]['names'][p2]}</b>"
            else:
                winner = "\n\n🤝 Ничья!"

            text = (
                f"🏁 <b>Игра окончена!</b>\n\n"
                f"{games[chat_id]['names'][p1]}: <b>{s1}</b>\n"
                f"{games[chat_id]['names'][p2]}: <b>{s2}</b>"
                f"{winner}"
            )
            del games[chat_id]
            await query.message.reply_text(text, parse_mode="HTML")
        return

def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("game", game_command))
    app.add_handler(CallbackQueryHandler(button))
    print("Бот запущен")
    app.run_polling(drop_pending_updates=True)

if __name__ == "__main__":
    main()
