def load_json(file):
    if os.path.exists(file):
        try:
            with open(file, "r", encoding="utf-8") as f:
                return json.load(f)
        except:
            pass
    return {}

def save_json(file, data):
    with open(file, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

custom_tasks = load_json(CUSTOM_FILE) or {"truth": [], "dare": []}
favorites = load_json(FAV_FILE) or {}

# ================== СОСТОЯНИЕ ИГР ==================
games = {}  # chat_id -> game state

def get_task(mood, ttype):
    pool = tasks.get(mood, {}).get(ttype, []).copy()
    pool.extend(custom_tasks.get(ttype, []))
    return random.choice(pool) if pool else "Заданий в этой категории пока нет."

# ================== КЛАВИАТУРЫ ==================
def main_kb():
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("🔥 Начать игру вдвоём", callback_data="new_game")],
        [InlineKeyboardButton("➕ Добавить своё задание", callback_data="add_task")],
        [InlineKeyboardButton("⭐ Избранные задания", callback_data="show_fav")]
    ])

def join_kb():
    return InlineKeyboardMarkup([[InlineKeyboardButton("✅ Я в деле", callback_data="join")]])

def role_kb(uid):
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton("Я — Он 👨", callback_data=f"role_him_{uid}"),
            InlineKeyboardButton("Я — Она 👩", callback_data=f"role_her_{uid}")
        ]
    ])

