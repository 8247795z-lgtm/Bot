    ])

# ================== ОБРАБОТЧИКИ ==================
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🔥 <b>Правда или Действие 18+</b>\n\nМаксимальная версия для пары.",
        reply_markup=main_kb(),
        parse_mode="HTML"
    )

async def game_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_chat.type == "private":
        await update.message.reply_text("Запускай игру в группе командой /game")
        return
    chat_id = update.effective_chat.id
    games[chat_id] = {
        "players": [],
        "names": {},
        "roles": {},
        "scores": {},
        "passes": {},
        "current": None,
        "mood": "dirty",
        "status": "join",
        "last_task": None
    }
    await update.message.reply_text("Оба игрока нажмите кнопку:", reply_markup=join_kb())

async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    data = q.data
    chat_id = q.message.chat_id
    user = q.from_user
    uid = user.id
    name = user.first_name
    game = games.get(chat_id)

    # ===== Новая игра =====
    if data == "new_game":
        if q.message.chat.type == "private":
            await q.edit_message_text("Используй /game в группе")
            return
        games[chat_id] = {
            "players": [], "names": {}, "roles": {}, "scores": {},
            "passes": {}, "current": None, "mood": "dirty", "status": "join", "last_task": None
        }
        await q.edit_message_text("Оба нажмите «Я в деле»:", reply_markup=join_kb())
        return

    if data == "join":
        if not game or game["status"] != "join":
            await q.answer("Игра уже началась", show_alert=True)
            return
        if uid in game["players"]:
            await q.answer("Ты уже в игре", show_alert=True)
            return
        game["players"].append(uid)
        game["names"][uid] = name
        game["scores"][uid] = 0
        game["passes"][uid] = 1

        if len(game["players"]) == 1:
            await q.edit_message_text(f"{name} в игре. Ждём второго...", reply_markup=join_kb())
        else:
            game["status"] = "roles"
            await q.edit_message_text(
                f"Оба в игре!\n\n{game['names'][game['players'][0]]} — выбери свою роль:",
                reply_markup=role_kb(game["players"][0])
            )
        return

    if data.startswith("role_"):
        role, target = data.split("_")[1], int(data.split("_")[2])
        if uid != target:
            await q.answer("Это не твоя кнопка", show_alert=True)
            return
        game["roles"][uid] = role
        other = [p for p in game["players"] if p != uid][0]
        if other not in game["roles"]:
            await q.edit_message_text(
                f"{name} выбрал(а) роль.\nТеперь {game['names'][other]} выбирает:",
                reply_markup=role_kb(other)
            )
        else:
            game["status"] = "mood"
            await q.edit_message_text("Выберите настроение игры:", reply_markup=mood_kb())
        return

    if data.startswith("mood_"):
        game["mood"] = data.replace("mood_", "")
        game["status"] = "playing"
        game["current"] = random.choice(game["players"])
        cur_name = game["names"][game["current"]]
